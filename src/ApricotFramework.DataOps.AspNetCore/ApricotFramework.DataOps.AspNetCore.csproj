<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for ApricotFramework.DataOps: data sources declared in configuration, connection factories registered in DI with a provider-invariant-name fallback, and additive registration of operation definition sources so a library can contribute its own operations without owning the composition root.</Description>
    <PackageTags>dapper;sql;data-access;aspnetcore;dependencyinjection;configuration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.DataOps/ApricotFramework.DataOps.csproj" />
  </ItemGroup>

</Project>
